{
  "name": "taxiag",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "taxiag",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "services/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=24"
      }
    },
    "node_modules/@taxiag/tokens": {
      "resolved": "packages/tokens",
      "link": true
    },
    "packages/tokens": {
      "name": "@taxiag/tokens",
      "version": "0.1.0"
    }
  }
}
