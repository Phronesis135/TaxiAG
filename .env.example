# Copy to .env and fill in. Never commit .env.
# Local Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://taxiag:taxiag@localhost:5432/taxiag
# Local Redis
REDIS_URL=redis://localhost:6379
# Better Auth (generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3001
# PayPal sandbox (https://developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Twilio trial (https://www.twilio.com/try-twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Postmark test server (https://postmarkapp.com)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=taxiag-dev
# Local mail catcher UI: http://localhost:8025 (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
